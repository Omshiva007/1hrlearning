# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/1hrlearning

# Redis
REDIS_URL=redis://:redis@127.0.0.1:56379

# JWT
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3100,http://localhost:3101

# Email — generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this encryption key stable; changing it makes provider credentials stored by the admin panel unreadable.
EMAIL_CREDENTIAL_ENCRYPTION_KEY=replace_with_64_character_hex_key
EMAIL_FROM=noreply@1hrlearning.com
# Legacy bootstrap only. After configuring a provider in Admin → Platform Configuration, this is not required.
SENDGRID_API_KEY=

# Sentry
SENTRY_DSN=

# App
APP_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101

# Seed / Admin (used by db:seed to create the initial admin account)
ADMIN_EMAIL=admin@1hrlearning.com
ADMIN_PASSWORD=Admin@1hrLearning2024!
ADMIN_USERNAME=admin
